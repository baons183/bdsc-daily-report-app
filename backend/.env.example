# Copy to .env and fill in values. This app owns its own new database
# (created automatically on first run) on the SAME SQL Server used by
# MaintenanceReportApp / checksheet-app.
PORT=8090

DB_SERVER=
DB_PORT=1433
DB_DATABASE=BDSC_DailyReport
DB_USERNAME=
DB_PASSWORD=

# Any random long string works; does NOT need to match the other apps'
# JWT_SECRET_KEY since this app keeps its own separate Users table/login.
JWT_SECRET_KEY=

# Where uploaded work-item photos are stored (served back at /uploads/...).
UPLOADS_DIR=./uploads
# Where each day's generated PDF report is written (served back at /reports/...).
# Point this at a SharePoint-synced local folder to have the report land on
# SharePoint automatically — pair with REPORT_SHAREPOINT_URL_PREFIX below so
# the email body can link straight to it.
REPORTS_DIR=./generated_reports

# Full path to the CBM (online-monitoring) Excel file that gets synced onto
# this machine daily by the external monitoring system. Leave blank to skip
# section 3.1 of the report.
CBM_EXCEL_PATH=

# Optional: a Power Automate Flow webhook (same pattern as the sibling apps'
# FLOW_URL) to email the finished report. Used only by the real 08:00 daily
# scheduled run.
EMAIL_FLOW_URL=

# Optional: a SEPARATE Flow webhook used only by the "Sinh báo cáo + Gửi
# email test" button in the Thống kê tab, so testing never triggers the
# real Flow above and risks emailing Ban Giám đốc by mistake.
EMAIL_FLOW_TEST_URL=

# Base SharePoint folder URL matching REPORTS_DIR above (leave blank if
# REPORTS_DIR isn't SharePoint-synced) — the email body links to
# <this>/<pdf file name> so recipients can open it without downloading the
# attachment. No trailing slash.
REPORT_SHAREPOINT_URL_PREFIX=

# Database (same SQL Server instance/login, different database) holding
# Asset_Master (TagName/Area/Unit/EquipDescription) — same equipment master
# table the sibling apps use — powers the Thiết bị search/autocomplete field.
ASSET_DB_NAME=MNT_Report_Mirror
